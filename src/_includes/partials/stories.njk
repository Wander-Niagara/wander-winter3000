{# WINTER READING — four framed prints, audience on the mat. #}
<section class="section {{ storiesField or 'field--night' }}" id="reading" data-module="stories">
  <div class="wrap">
    <div class="section__head head-row">
      <div><h2>{{ storiesTitle or "Winter reading" }}</h2><p>Stories to plan a weekend by.</p></div>
      <a class="tlink" href="/blog/" data-module="stories" data-card-label="All stories">All stories</a>
    </div>
    <div class="stories stories--4">
      {% for a in collections.articles %}
      {% set ph = slots.photos[a.data.heroSlotKey] %}
      <a class="story" href="{{ a.url }}" data-module="stories" data-card-label="{{ a.data.title }}">
        <span class="print{% if not (ph and ph.embed) %} print--placeholder{% endif %}">
          <span class="print__mat">
            <span class="story__audience">{{ a.data.audience }}</span>
            {% if ph and ph.embed %}<img class="print__img" src="{{ ph.embed }}" alt="" loading="lazy" decoding="async">{% else %}<span class="print__img">{{ a.data.heroSlotKey }} · photo</span>{% endif %}
          </span>
        </span>
        <span class="story__body">
          <h3>{{ a.data.title }}</h3>
          <p>{{ a.data.dek }}</p>
          <span class="tlink">Read the story</span>
        </span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% set storiesField = "" %}{% set storiesTitle = "" %}
