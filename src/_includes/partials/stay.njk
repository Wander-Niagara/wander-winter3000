{# STAY THE NIGHT — the primary bedroom as a framed print on chintz paper, accommodation tags. #}
{% set stayTheme = null %}{% for t in businesses.eatdrinkplay.themes %}{% if t.key == "accommodations" %}{% set stayTheme = t %}{% endif %}{% endfor %}
<section class="section field--chintz on-light" id="accommodations" data-module="theme">
  <div class="wrap">
    <div class="twoup">
      <div>
        <div class="section__head"><h2>Stay the night</h2><p>{{ stayIntro or "Boutique inns in Jordan Village, winery guesthouses on the bench, and the region's biggest choice of hotels in St. Catharines." }}</p></div>
      </div>
      <figure class="print"><span class="print__mat"><picture><source type="image/avif" srcset="/assets/plates/room-bedroom-800.avif 800w, /assets/plates/room-bedroom-1536.avif 1536w" sizes="(min-width:900px) 480px, 92vw"><source type="image/webp" srcset="/assets/plates/room-bedroom-800.webp 800w, /assets/plates/room-bedroom-1536.webp 1536w" sizes="(min-width:900px) 480px, 92vw"><img class="print__img" src="/assets/plates/room-bedroom.png" width="1536" height="1024" alt="A bedroom with a four-poster bed, a red comforter and a tartan blanket, decorated for the holidays" loading="lazy" decoding="async"></picture></span></figure>
    </div>
    {% if stayTheme %}{% set tagItems = stayTheme.items %}{% set tagModule = "theme" %}{% include "partials/tags.njk" %}{% endif %}
    <p class="section-cta"><a class="plaque" href="{{ site.directoryUrl }}" target="_blank" rel="noopener" data-module="directory" data-card-label="See all places to stay">See all places to stay</a></p>
  </div>
</section>
{% set stayIntro = "" %}
