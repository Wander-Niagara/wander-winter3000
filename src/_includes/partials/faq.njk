{# FAQ — stockings on a mantel. Native <details>; FAQPage JSON-LD emitted here. #}
{% if faq and faq.length %}
<section class="section {{ faqField or 'field--night' }}" id="faq" data-module="faq">
  <div class="wrap">
    <div class="section__head"><h2>Questions, answered</h2></div>
    <div class="mantel">
      <div class="mantel__shelf" aria-hidden="true"></div>
      <div class="faq">
        {% for qa in faq %}
        <details{% if loop.first %} open{% endif %}>
          <summary>{{ qa.q }}</summary>
          <div class="faq__a">{{ qa.a | safe }}</div>
        </details>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for qa in faq %}{
      "@type": "Question",
      "name": {{ qa.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ (qa.a | striptags) | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
{% set faqField = "" %}
