      {% set photoKey = "HOME_TWOUP_RURAL" %}{% set photoShape = "" %}{% set photoCaption = "Jordan Village, Benchlands" %}{% set photoHref = "/eatdrinkplay/#shopping" %}{% include "partials/photo-print.njk" %}
