{# HOME — everything below the house, in the fall site's order with winter content. #}
<section class="section break field--night" data-module="home">
  <div class="wrap">
    <p class="break__lede">Holiday lights on every main street. Wine country under snow. Five <em>MICHELIN</em> Guide restaurants with tables to spare. Markets, tree farms, skating, and a quiet trail to a frozen waterfall. All of it within 90 minutes of Toronto.</p>
    <div class="twoup">
      {% set photoKey = "HOME_BREAK_LIGHTS" %}{% set photoShape = "" %}{% set photoCaption = "Downtown St. Catharines, lit for the season" %}{% set photoHref = "/outdoors/#lights-and-trails" %}{% include "partials/photo-print.njk" %}
      {% set photoKey = "HOME_BREAK_VINES" %}{% set photoShape = "" %}{% set photoCaption = "The Benchlands after a snowfall" %}{% set photoHref = "/eatdrinkplay/#wine" %}{% include "partials/photo-print.njk" %}
    </div>
  </div>
</section>

