        <a href="https://www.instagram.com/lovestc_/" title="Follow us on Instagram" target="_blank" rel="noopener" data-module="footer" data-card-label="STC Instagram">{{ icoInstagram | safe }}<span class="visually-hidden">Instagram</span></a>
        <a href="https://www.youtube.com/channel/UCp01QDn7_G8fgiUsb6gWUjg" title="Watch on YouTube" target="_blank" rel="noopener" data-module="footer" data-card-label="STC YouTube">{{ icoYoutube | safe }}<span class="visually-hidden">YouTube</span></a>
      </div>
    </div>
    <div class="site-footer__col">
      <h4>Follow Niagara Benchlands</h4>
      <div class="social">
        <a href="https://facebook.com/niagarabenchlands" title="Like us on Facebook" target="_blank" rel="noopener" data-module="footer" data-card-label="Benchlands Facebook">{{ icoFacebook | safe }}<span class="visually-hidden">Facebook</span></a>
