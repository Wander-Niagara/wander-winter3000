<section class="funders" aria-labelledby="funders-title">
  <div class="funders__wrap">
    <h3 class="funders__title boxed" id="funders-title">Thank you to our funders</h3>
    <div class="funders__grid">
      <a href="https://www.ontario.ca/" target="_blank" rel="noopener"><img src="/assets/img/logos/funder-ontario.png" alt="Ontario" width="360" height="124" loading="lazy" decoding="async"></a>
      <a href="https://www.visitniagaracanada.com/" target="_blank" rel="noopener"><img src="/assets/img/logos/funder-visit-niagara.png" alt="Visit Niagara Canada" width="360" height="124" loading="lazy" decoding="async"></a>
      <a href="https://www.lincoln.ca/" target="_blank" rel="noopener"><img src="/assets/img/logos/funder-lincoln.png" alt="Town of Lincoln" width="360" height="124" loading="lazy" decoding="async"></a>
      <a href="https://www.niagarabenchlands.ca/" target="_blank" rel="noopener"><img src="/assets/img/logos/funder-benchlands-lincoln.png" alt="Niagara Benchlands, Lincoln Ontario" width="1024" height="353" loading="lazy" decoding="async"></a>
      <a href="https://lovestc.ca/" target="_blank" rel="noopener"><img src="/assets/img/logos/funder-lovestc.png" alt="LoveSTC | Tourism St. Catharines" width="783" height="270" loading="lazy" decoding="async"></a>
      <a href="https://www.stcatharines.ca/en/index.aspx" target="_blank" rel="noopener"><img src="/assets/img/logos/funder-st-catharines.png" alt="St. Catharines" width="783" height="270" loading="lazy" decoding="async"></a>
    </div>
  </div>
</section>

<footer class="site-footer">
