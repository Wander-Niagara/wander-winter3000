{# Slim header on the night sky: logo left, section links (desktop), one brass
   plaque CTA right. The CTA is the only control in the first viewport's header. #}
<header class="site-header" id="site-header">
  <a class="brand" href="/" aria-label="{{ site.name }} — home">
    <img src="/assets/img/logos/wander-footer.svg" alt="Wander — St. Catharines and the Benchlands" width="255" height="121" decoding="async">
  </a>
  <nav class="site-nav" aria-label="Sections">
    {% for item in site.nav %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}
  </nav>
  {% if variant == "events" %}<a class="plaque plaque--sm" href="/eatdrinkplay/" data-module="header" data-card-label="Eat and drink">Eat and drink</a>
  {% else %}<a class="plaque plaque--sm" href="{{ site.cta.href }}" data-module="header" data-card-label="{{ site.cta.label }}">{{ site.cta.label }}</a>{% endif %}
</header>
