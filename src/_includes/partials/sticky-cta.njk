{# Sticky bottom CTA bar on mobile, revealed once the hero sentinel scrolls out. #}
<div class="sticky-cta" aria-label="Quick links">
  <a class="plaque plaque--sm" href="{{ site.stickyCta.primary.href }}" data-module="sticky-cta" data-card-label="{{ site.stickyCta.primary.label }}">{{ site.stickyCta.primary.label }}</a>
  <a class="sticky-cta__alt" href="{{ site.stickyCta.secondary.href }}" data-module="sticky-cta" data-card-label="{{ site.stickyCta.secondary.label }}">{{ site.stickyCta.secondary.label }}</a>
</div>
