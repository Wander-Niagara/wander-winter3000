{# ARTICLE IMAGE SLOT — inline article photos from slots.photos (each carries its own alt).
   Usage: {% set imgSlotKey = "BLOG_MICHELIN_1" %}{% include "partials/img-slot.njk" %} #}
{% set imgSlot = slots.photos[imgSlotKey] %}
{% if imgSlot and imgSlot.embed %}
<figure class="article-img print"><span class="print__mat"><img class="print__img" src="{{ imgSlot.embed }}" alt="{{ imgSlotAlt or imgSlot.alt or '' }}" loading="lazy" decoding="async"></span></figure>
{% elif slots.showPlaceholders %}
<div class="widget-slot widget-slot--img" data-slot="{{ imgSlotKey }}"><p class="widget-slot__label">{{ imgSlotKey }} · {{ imgSlot.label if imgSlot else "photo" }}</p><div class="widget-slot__grid" aria-hidden="true"><i></i></div></div>
{% endif %}
{% set imgSlotAlt = "" %}
