<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#121C33">
  <title>{{ title }}{% if title %} — {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title or site.campaign }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% set ogImg = ogImage or "/assets/img/og-house.jpg" %}
  <meta property="og:image" content="{{ site.url }}{{ ogImg }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png"><link rel="icon" href="/assets/img/favicon-192.png" sizes="192x192" type="image/png"><link rel="apple-touch-icon" href="/assets/img/favicon-192.png">

  {# Self-hosted faces: Libre Caslon Text (display) and Vollkorn (text). #}
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/LibreCaslonText-700-latin.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Vollkorn-var-latin.woff2" crossorigin>
  {% if variant == "home" %}
  <link rel="preload" as="image" type="image/avif" media="(max-width:899px)" imagesrcset="/assets/plates/facade-780.avif 780w, /assets/plates/facade-1170.avif 1170w, /assets/plates/facade-1536.avif 1536w" imagesizes="100vw" fetchpriority="high">
  <link rel="preload" as="image" type="image/avif" media="(min-width:900px)" imagesrcset="/assets/plates/facade-wide-1024.avif 1024w, /assets/plates/facade-wide-1536.avif 1536w" imagesizes="min(100vw, 1200px)" fetchpriority="high">
  {% endif %}
  {% for origin in embeds.preconnect %}<link rel="preconnect" href="{{ origin }}" crossorigin>
  {% endfor %}

  {# JS gate: .js enables progressive behaviours; .seq arms the window light-up
     sequence only when motion is allowed, so the windows are lit by default. #}
  <script>(function(d){d.classList.add('js');if(!matchMedia('(prefers-reduced-motion: reduce)').matches)d.classList.add('seq');})(document.documentElement)</script>

  <style>{{ "assets/css/critical.css" | readFile | safe }}</style>
  <link rel="preload" as="style" href="/assets/css/main.css" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="/assets/css/main.css"></noscript>

  <script type="application/json" id="wn-config">
  {
    "ga4Id": {{ (embeds.ga4Id or "") | dump | safe }},
    "metaPixelId": {{ (embeds.metaPixelId or "") | dump | safe }},
    "gtmId": {{ (embeds.gtmId or "") | dump | safe }},
    "stackAdaptPixelId": {{ (embeds.stackAdaptPixelId or "") | dump | safe }},
    "plausibleSrc": {{ (embeds.plausibleSrc or "") | dump | safe }},
    "variant": {{ (variant or "") | dump | safe }},
    "ref": {
      "enabled": {{ "true" if site.outboundRef.enabled else "false" }},
      "param": {{ site.outboundRef.param | dump | safe }},
      "value": {{ site.outboundRef.value | dump | safe }},
      "disabledDomains": {{ site.outboundRef.disabledDomains | dump | safe }}
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "sameAs": [{% for s in site.social %}"{{ s.url }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  }
  </script>
  {% block head %}{% endblock %}
</head>
<body class="page page--{{ variant }}">
  <a class="skip" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {% block content %}{{ content | safe }}{% endblock %}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/sticky-cta.njk" %}
  {% include "partials/newsletter-modal.njk" %}
  <script src="/assets/js/app.js" defer></script>
</body>
</html>
