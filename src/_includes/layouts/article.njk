{# ARTICLE — title, dek, hero print, readable body, Keep exploring trio, page tail. #}
{% extends "base.njk" %}
{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  {% if dek %}"alternativeHeadline": {{ dek | dump | safe }},{% endif %}
  "datePublished": "{{ date }}",
  "author": { "@type": "Organization", "name": "{{ site.name }}" },
  "publisher": { "@type": "Organization", "name": "{{ site.name }}", "url": "{{ site.url }}" },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}"
}
</script>
{% endblock %}
{% block content %}
  <div class="article-head">
    <h1>{{ title }}</h1>
    {% if dek %}<p class="dek">{{ dek }}</p>{% endif %}
    <p class="meta">Written for {{ audience | lower }} · Winter reading</p>
  </div>
  <div class="article-hero">
    {% set photoKey = heroSlotKey %}{% set photoShape = "wide" %}{% include "partials/photo-print.njk" %}
  </div>
  <div class="prose">
    {{ content | safe }}
    <p class="article-back"><a class="tlink" href="{{ backHref }}">← {{ backLabel }}</a></p>
  </div>
  {% if widgetSlotKey %}
  <section class="section field--bottle" id="{{ widgetSlotKey | lower }}" data-module="article">
    <div class="wrap"><div class="section__head"><h2>{{ widgetHeading or "Explore" }}</h2></div>{% set slotKey = widgetSlotKey %}{% set slotCells = 8 %}{% include "partials/widget-slot.njk" %}</div>
  </section>
  {% endif %}
  {% if keepExploring %}
  <section class="section field--red keep" id="keep-exploring" data-module="theme">
    <div class="wrap">
      <div class="section__head"><h2>Keep exploring</h2></div>
      {% set tagItems = keepExploring | keepItems(businesses) %}{% set tagModule = "theme" %}{% include "partials/tags.njk" %}
    </div>
  </section>
  {% endif %}
  <span id="hero-cta-sentinel" aria-hidden="true"></span>
  {% include "partials/page-tail.njk" %}
{% endblock %}
