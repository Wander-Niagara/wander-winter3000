---
# Legacy-URL redirects: none yet for the winter site. Kept as the pattern from
# the fall build so interim preview slugs can be redirected without template work.
layout: null
eleventyExcludeFromCollections: true
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}"
redirects:
  - { from: "/eat-drink-play/index.html", to: "/eatdrinkplay/" }
  - { from: "/stories/index.html", to: "/blog/" }
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>This page has moved — Wander Niagara</title>
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content="0; url={{ r.to }}">
  <link rel="canonical" href="{{ site.url }}{{ r.to }}">
</head>
<body>
  <p>This page has moved to <a href="{{ r.to }}">{{ r.to }}</a>.</p>
</body>
</html>
