---
# Legacy-URL redirects. Old paths meta-refresh to the client's final campaign
# slugs so anything already shared (interim previews, stakeholder links) never
# 404s. Root-relative `to` is rewritten with the pathPrefix by HtmlBasePlugin,
# so these work on both the GitHub Pages and Flywheel (/fall/) targets.
layout: null
eleventyExcludeFromCollections: true
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}"
redirects:
  - { from: "/families/index.html", to: "/fallcolors/" }
  - { from: "/couples-and-friends/index.html", to: "/eatdrinkplay/" }
  - { from: "/couples/index.html", to: "/eatdrinkplay/" }
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>This page has moved — Wander Niagara</title>
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content="0; url={{ r.to }}">
  <link rel="canonical" href="{{ site.url }}{{ r.to }}">
</head>
<body>
  <p>This page has moved to <a href="{{ r.to }}">{{ r.to }}</a>.</p>
</body>
</html>
