{
  "name": "wander-niagara-fall",
  "version": "1.0.0",
  "description": "Wander Niagara \u2014 Fall in St. Catharines & the Benchlands campaign microsite. Static, mobile-first, tracking-heavy landing pages for paid media.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "eleventy --serve",
    "dev": "eleventy --serve",
    "build": "eleventy",
    "clean": "rm -rf _site dist-flywheel",
    "build:flywheel": "cross-env DEPLOY_TARGET=flywheel eleventy",
    "serve:flywheel": "cross-env DEPLOY_TARGET=flywheel eleventy --serve --port=8081"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "cross-env": "^10.1.0",
    "puppeteer-core": "^25.8.0"
  }
}
